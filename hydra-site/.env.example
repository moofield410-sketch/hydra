# Copy to .env and fill in what exists. Anything left empty shows its pre-launch state (no simulated data).
# The site's own address, no trailing slash (e.g. https://hydra.example): makes the X link card work
VITE_SITE_URL=
VITE_X_HANDLE=TheHydraAgent
VITE_CHAIN_ID=4663
VITE_CHAIN_NAME=Robinhood Chain
VITE_RPC_URL=
VITE_EXPLORER=
VITE_ORBIO_TOKEN=
VITE_HYDRA_TOKEN=
VITE_DEFENSE_VAULT=
VITE_SURVIVOR_NFT=
# HydraTreasury: printed by contracts/script/Deploy.s.sol
VITE_TREASURY=
# HydraSpawn (ERC-721): printed by contracts/script/Deploy.s.sol
VITE_SPAWN_NFT=
# Mint start, unix seconds: drives the countdown before VITE_SPAWN_NFT is set
VITE_MINT_START=
VITE_PROOFS_BASE=
VITE_SUPABASE_URL=
# The public anon key only, never the service key
VITE_SUPABASE_ANON_KEY=
